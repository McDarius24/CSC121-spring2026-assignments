      "source": [
        "# NAME: rectangle.py\n",
        "# IMPORT STATEMENTS\n",
        "\n",
        "# FUNCTION DEFINITIONS\n",
        "# Define calculate_rectangle to accept two parameters: length and width\n",
        "def calculate_rectangle(length, width):\n",
        "# This should calculate the Area(length*width) and the perimeter(2*(length + width))\n",
        "    area = length * width\n",
        "    perimeter = 2 * (length + width)\n",
        "# this should return both results as a single tuple in the format:(area,perimeter)\n",
        "    return area, perimeter\n",
        "\n",
        "# PROGRAM LOGIC\n",
        "# Ask the user to input a length and a width and convert them to floats\n",
        "length = float(input(\"Enter the length of the rectangle: \"))\n",
        "width = float(input(\"Enter the width of the rectangle: \"))\n",
        "# Call the calculate_rectangle function using the user's input\n",
        "results = calculate_rectangle(length, width)\n",
        "# Unpack the returned tuple into two seperate variables called my_area and my perimeter\n",
        "my_area, my_perimeter = results\n",
        "# Print the results clearly for the user\n",
        "print(\"---Results---\")\n",
        "print(f\"The area of the rectangle is: {my_area}\")\n",
        "print(f\"The perimeter of the rectangle is: {my_perimeter}\")"
      ]
