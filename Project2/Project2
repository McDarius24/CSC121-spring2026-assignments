        "def add_to_wishlist(df, title, platform, target_price, current_price=None, store_link=None):\n",
        "    \"\"\"Adds a game to the wishlist DataFrame.\"\"\"\n",
        "    # Clean string inputs\n",
        "    title = str(title).strip()\n",
        "    platform = str(platform).strip()\n",
        "    if store_link is not None: store_link = str(store_link).strip()\n",
        "\n",
        "    try:\n",
        "        target_price = float(target_price)\n",
        "        if current_price is not None: current_price = float(current_price)\n",
        "    except ValueError:\n",
        "        print(\"Prices must be numbers.\")\n",
        "        return df\n",
        "\n",
        "    new_item = pd.DataFrame([{'Title': title, 'Platform': platform, 'Target Price': target_price,\n",
        "                                'Current Price': current_price, 'Store Link': store_link}])\n",
        "    updated_df = pd.concat([df, new_item], ignore_index=True)\n",
        "    print(f\"Added '{title}' to the wishlist.\")\n",
        "    return updated_df\n",
        "\n",
        "def update_wishlist_price(df, title, platform, new_price):\n",
        "    \"\"\"Updates the current price for a game on the wishlist.\"\"\"\n",
        "    # Clean string inputs\n",
        "    title = str(title).strip()\n",
        "    platform = str(platform).strip()\n",
        "\n",
        "    try:\n",
        "        new_price = float(new_price)\n",
        "    except ValueError:\n",
        "        print(\"New price must be a number.\")\n",
        "        return df\n",
        "\n",
        "    mask = (df['Title'].str.lower() == title.lower()) & (df['Platform'].str.lower() == platform.lower())\n",
        "    if mask.any():\n",
        "        df.loc[mask, 'Current Price'] = new_price\n",
        "        print(f\"Updated current price for '{title}' to {new_price}.\")\n",
        "    else:\n",
        "        print(f\"Game '{title}' on platform '{platform}' not found in wishlist.\")\n",
        "    return df\n",
        "\n",
        "def check_price_alerts(wishlist_df):\n",
        "    \"\"\"Checks for games on the wishlist whose current price is at or below the target price.\"\"\"\n",
        "    if wishlist_df.empty:\n",
        "        return \"No items in wishlist to check for price alerts.\"\n",
        "\n",
        "    alerts = wishlist_df[(wishlist_df['Current Price'].notna()) & (wishlist_df['Current Price'] <= wishlist_df['Target Price'])]\n",
        "    if alerts.empty:\n",
        "        return \"No price alerts at this time.\"\n",
        "    else:\n",
        "        alert_message = \"Price Alerts! The following games are at or below their target price:\\n\"\n",
        "        for index, row in alerts.iterrows():\n",
        "            alert_message += f\"  - {row['Title']} ({row['Platform']}): Current Price ${row['Current Price']} (Target ${row['Target Price']})\\n\"\n",
        "        return alert_message"
      ],
      "execution_count": 50,
      "outputs": []
    },
