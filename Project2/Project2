        "from datetime import datetime, timedelta\n",
        "\n",
        "def log_play_session(df, title, platform, start_time_str, end_time_str, notes=\"\"):\n",
        "    \"\"\"Logs a single play session for a game.\"\"\"\n",
        "    # Clean string inputs\n",
        "    title = str(title).strip()\n",
        "    platform = str(platform).strip()\n",
        "    notes = str(notes).strip()\n",
        "\n",
        "    try:\n",
        "        start_time = datetime.fromisoformat(start_time_str)\n",
        "        end_time = datetime.fromisoformat(end_time_str)\n",
        "        if end_time < start_time:\n",
        "            print(\"End time cannot be before start time.\")\n",
        "            return df\n",
        "    except ValueError:\n",
        "        print(\"Invalid date/time format. Please use ISO format (e.g., 'YYYY-MM-DD HH:MM:SS').\")\n",
        "        return df\n",
        "\n",
        "    duration_minutes = (end_time - start_time).total_seconds() / 60\n",
        "\n",
        "    new_session = pd.DataFrame([{'Title': title, 'Platform': platform, 'Start Time': start_time,\n",
        "                                 'End Time': end_time, 'Duration (minutes)': duration_minutes, 'Notes': notes}])\n",
        "    updated_df = pd.concat([df, new_session], ignore_index=True)\n",
        "    print(f\"Logged a {duration_minutes:.0f} minute session for '{title}'.\")\n",
        "    return updated_df\n",
        "\n",
        "def calculate_total_playtime(df, by_column=None):\n",
        "    \"\"\"Calculates total playtime, optionally grouped by a column.\"\"\"\n",
        "    if df.empty:\n",
        "        return \"No play sessions logged to calculate playtime.\"\n",
        "\n",
        "    if by_column and by_column in df.columns:\n",
        "        total_playtime = df.groupby(by_column)['Duration (minutes)'].sum().round(0)\n",
        "        return f\"Total playtime by {by_column} (minutes):\\n{total_playtime}\"\n",
        "    else:\n",
        "        overall_total = df['Duration (minutes)'].sum().round(0)\n",
        "        return f\"Overall total playtime: {overall_total} minutes\""
      ],
      "execution_count": 51,
