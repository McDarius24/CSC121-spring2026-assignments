      "source": [
        "### Demonstration of Usage"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 591
        },
        "id": "ffd1b2a2",
        "outputId": "fa003cf6-9cdb-4e44-abbb-f7bafcf340de"
      },
      "source": [
        "# 1. Load the game library (or create an empty one if it doesn't exist)\n",
        "game_library_df = load_library(FILE_PATH)\n",
        "\n",
        "# 2. Add some sample games\n",
        "game_library_df = add_game(game_library_df, 'The Witcher 3', 'PC', 'RPG', 9)\n",
        "game_library_df = add_game(game_library_df, 'Cyberpunk 2077', 'PC', 'RPG', 7)\n",
        "game_library_df = add_game(game_library_df, 'Red Dead Redemption 2', 'PlayStation', 'Action', 10)\n",
        "game_library_df = add_game(game_library_df, 'Hades', 'Nintendo Switch', 'Roguelike', 9)\n",
        "\n",
        "# 3. Display the current library\n",
        "print(\"\\n--- Current Game Library ---\")\n",
        "display(game_library_df)\n",
        "\n",
        "# 4. Calculate and display average ratings\n",
        "print(\"\\n\" + calculate_average_rating(game_library_df))\n",
        "print(\"\\n\" + calculate_average_rating(game_library_df, by_column='Platform'))\n",
        "print(\"\\n\" + calculate_average_rating(game_library_df, by_column='Genre'))\n",
        "\n",
        "# 5. Save the updated library\n",
        "save_library(game_library_df, FILE_PATH)"
      ],
