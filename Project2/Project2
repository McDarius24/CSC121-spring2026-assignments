        "# Game Library Manager"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "0ba51fa3"
      },
      "source": [
        "This program allows you to manage your personal video game library. You can add games, view your collection, calculate statistics like average ratings, and save/load your data."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "daab48b4"
      },
      "source": [
        "import pandas as pd\n",
        "import os"
      ],
      "execution_count": 8,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "2598cd00"
      },
      "source": [
        "# Define the file path for saving/loading the game library\n",
        "FILE_PATH = 'game_library.csv'"
      ],
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "6464a974"
      },
      "source": [
        "### Load and Save Functions"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "11ff2268"
      },
      "source": [
        "def load_library(file_path):\n",
        "    \"\"\"Loads the game library from a CSV file.\"\"\"\n",
        "    if os.path.exists(file_path):\n",
        "        df = pd.read_csv(file_path)\n",
        "        print(f\"Game library loaded from {file_path}.\")\n",
        "        return df\n",
        "    else:\n",
        "        print(\"No existing game library found. Starting a new one.\")\n",
        "        return pd.DataFrame(columns=['Title', 'Platform', 'Genre', 'Rating'])\n",
        "\n",
        "def save_library(df, file_path):\n",
        "    \"\"\"Saves the game library to a CSV file.\"\"\"\n",
        "    df.to_csv(file_path, index=False)\n",
        "    print(f\"Game library saved to {file_path}.\")"
      ],
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2c18ef53"
      },
      "source": [
        "### Core Library Management Functions"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "09cd2bbe"
      },
      "source": [
        "def add_game(df, title, platform, genre, rating):\n",
        "    \"\"\"Adds a new game to the library DataFrame.\"\"\"\n",
        "    # Ensure rating is an integer and within a reasonable range (e.g., 1-10)\n",
        "    try:\n",
        "        rating = int(rating)\n",
        "        if not (1 <= rating <= 10):\n",
        "            print(\"Rating must be between 1 and 10.\")\n",
        "            return df\n",
        "    except ValueError:\n",
        "        print(\"Rating must be a number.\")\n",
        "        return df\n",
        "\n",
        "    new_game = pd.DataFrame([{'Title': title, 'Platform': platform, 'Genre': genre, 'Rating': rating}])\n",
        "    updated_df = pd.concat([df, new_game], ignore_index=True)\n",
        "    print(f\"Added '{title}' to the library.\")\n",
        "    return updated_df\n",
        "\n",
        "def calculate_average_rating(df, by_column=None):\n",
        "    \"\"\"Calculates the average rating, optionally grouped by a column.\"\"\"\n",
        "    if df.empty:\n",
        "        return \"No games in the library to calculate ratings.\"\n",
        "\n",
        "    if by_column and by_column in df.columns:\n",
        "        avg_ratings = df.groupby(by_column)['Rating'].mean().round(2)\n",
        "        return f\"Average ratings by {by_column}:\\n{avg_ratings}\"\n",
        "    else:\n",
        "        overall_avg = df['Rating'].mean().round(2)\n",
        "        return f\"Overall average rating: {overall_avg}\""
      ],
      "execution_count": 11,
      "outputs": []
    },
