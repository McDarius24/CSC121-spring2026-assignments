        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from IPython.display import display\n",
        "\n",
        "# FUNCTION DEFINITIONS\n",
        "# Define add_expense() to prompt the user to enter a new expense record that includes 'Category', 'Vendor', 'Amount', and 'Date'.\n",
        "def add_expense(expenses):\n",
        "    category = input(\"Enter the expense category: \")\n",
        "    vendor = input(\"Enter the expense vendor: \")\n",
        "    amount = float(input(\"Enter the expense amount: \"))\n",
        "    date = input(\"Enter the expense date (YYYY-MM-DD): \")\n",
        "    expenses.append({'Category': category, 'Vendor': vendor, 'Amount': amount, 'Date': date})\n",
        "    print(\"Expense added successfully!\")\n",
        "\n",
        "# Define get_expenses_dataframe() function to convert the global list of expense dictionaries into a pandas DataFrame and should also ensure that the 'Amount' column is cast to a numeric type and the 'Date' column to a datetime type.\n",
        "def get_expenses_dataframe(expenses):\n",
        "    if not expenses:\n",
        "        print(\"No expenses recorded yet.\")\n",
        "        return pd.DataFrame(columns=['Category', 'Vendor', 'Amount', 'Date'])\n",
        "    df = pd.DataFrame(expenses)\n",
        "    df['Amount'] = pd.to_numeric(df['Amount'], errors='coerce')\n",
        "    df['Date'] = pd.to_datetime(df['Date'], errors='coerce')\n",
        "    return df\n",
        "\n",
        "# Define report_all_expenses() to generate a report of all recorded expenses by retrieving the DataFrame using get_expenses_Dataframe(), calculating total sum of all amounts, printing the overall total the display the entire DataFrame sorted by 'Date'.\n",
        "def report_all_expenses(expenses):\n",
        "    df = get_expenses_dataframe(expenses)\n",
        "    if df.empty:\n",
        "        return\n",
        "    total_sum = df['Amount'].sum()\n",
        "    print(f\"Overall Total: ${total_sum:.2f}\")\n",
        "    display(df.sort_values(by='Date'))\n",
        "\n",
        "# Define report_by_category() to prompt the user for a specifc category, and it should filter the expenses Dataframe by that category, and calculate the filtered expenses\n",
        "def report_by_category(expenses):\n",
        "    category = input(\"Enter the expense category: \")\n",
        "    df = get_expenses_dataframe(expenses)\n",
        "    if df.empty:\n",
        "        return\n",
        "    category_expenses = df[df['Category'].str.lower() == category.lower()] # Case-insensitive comparison\n",
        "    if category_expenses.empty:\n",
        "        print(f\"No expenses found for category: {category}\")\n",
        "        return\n",
        "    total_sum = category_expenses['Amount'].sum()\n",
        "    print(f\"Total for {category}: ${total_sum:.2f}\")\n",
        "    display(category_expenses.sort_values(by='Date'))\n",
        "\n",
        "# Define report_by_vendor to prompt the user for a specific vendor and it will filter the expenses DataFrame by that vendor and it will calculate the total for filtered expenses.\n",
        "def report_by_vendor(expenses):\n",
        "    vendor = input(\"Enter the expense vendor: \")\n",
        "    df = get_expenses_dataframe(expenses)\n",
        "    if df.empty:\n",
        "        return\n",
        "    vendor_expenses = df[df['Vendor'].str.lower() == vendor.lower()] # Case-insensitive comparison\n",
        "    if vendor_expenses.empty:\n",
        "        print(f\"No expenses found for vendor: {vendor}\")\n",
        "        return\n",
        "    total_sum = vendor_expenses['Amount'].sum()\n",
        "    print(f\"Total for {vendor}: ${total_sum:.2f}\")\n",
        "    display(vendor_expenses.sort_values(by='Date'))\n",
        "\n",
        "# PROGRAM LOGIC\n",
        "# main() will be the main entry point of the program and it will establish a continous loop that shows a menu of options to the user: 1. Add New Expense, 2. Get Totals, 3. Exit. It should ensure robust handling of user input including validation for menu choices. The loop should terminate when the user selects the Exit option.\n",
        "def main():\n",
        "    expenses = []\n",
        "    while True:\n",
        "        print(\"\\n--- Expense Tracker ---\")\n",
        "        print(\"1. Add New Expense\")\n",
        "        print(\"2. Get Totals\")\n",
        "        print(\"3. Exit\")\n",
        "        choice = input(\"Selection: \")\n",
        "\n",
        "        if choice == '1':\n",
        "            add_expense(expenses)\n",
        "        elif choice == '2':\n",
        "            while True:\n",
        "                print(\"\\n--- Totaling Options ---\")\n",
        "                print(\"A: All Expenses\")\n",
        "                print(\"C: Filter by Category\")\n",
        "                print(\"V: Filter by Vendor\")\n",
        "                print(\"B: Back to Main Menu\")\n",
        "                report_choice = input(\"Choice: \").upper()\n",
        "\n",
        "                if report_choice == 'A':\n",
        "                    report_all_expenses(expenses)\n",
        "                elif report_choice == 'C':\n",
        "                    report_by_category(expenses)\n",
        "                elif report_choice == 'V':\n",
        "                    report_by_vendor(expenses)\n",
        "                elif report_choice == 'B': # Exit from sub-menu\n",
        "                    break\n",
        "                else:\n",
        "                    print(\"Invalid choice. Please try again.\")\n",
        "        elif choice == '3':\n",
        "            print(\"Exiting the program.\")\n",
        "            break # This exits the main while loop\n",
        "        else:\n",
        "            print(\"Invalid choice. Please try again.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    }
