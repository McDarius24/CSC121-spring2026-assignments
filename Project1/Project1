      "source": [
        "tasks = []\n",
        "COMPLETED_TASKS_FILE = 'completed_tasks.txt'\n",
        "\n",
        "def add_task():\n",
        "    task_name = input(\"Enter task name: \")\n",
        "    while True:\n",
        "        try:\n",
        "            priority = int(input(\"Enter priority (1: High, 2: Medium, 3: Low): \"))\n",
        "            if 1 <= priority <= 3:\n",
        "                tasks.append({'name': task_name, 'priority': priority})\n",
        "                print(f\"Task '{task_name}' added with priority {priority}.\")\n",
        "                break\n",
        "            else:\n",
        "                print(\"Invalid priority. Please enter 1, 2, or 3.\")\n",
        "        except ValueError:\n",
        "            print(\"Invalid input. Please enter a number for priority.\")\n",
        "\n",
        "def view_tasks():\n",
        "    if not tasks:\n",
        "        print(\"No tasks to display.\")\n",
        "        return\n",
        "\n",
        "    # Sort tasks by priority (lower number = higher priority)\n",
        "    sorted_tasks = sorted(tasks, key=lambda x: x['priority'])\n",
        "\n",
        "    print(\"\\n--- Your Tasks ---\")\n",
        "    priority_map = {1: 'High', 2: 'Medium', 3: 'Low'}\n",
        "    for i, task in enumerate(sorted_tasks, 1):\n",
        "        print(f\"{i}. {task['name']} (Priority: {priority_map[task['priority']]})\")\n",
        "    print(\"------------------\\n\")\n",
        "    return sorted_tasks\n",
        "\n",
        "def complete_task():\n",
        "    if not tasks:\n",
        "        print(\"No tasks to complete.\")\n",
        "        return\n",
        "\n",
        "    sorted_tasks = view_tasks() # Display tasks and get the sorted list\n",
        "    if not sorted_tasks: # Check if view_tasks had anything to display\n",
        "        return\n",
        "\n",
        "    while True:\n",
        "        try:\n",
        "            task_index = int(input(\"Enter the number of the task to complete: \")) - 1\n",
        "            if 0 <= task_index < len(sorted_tasks):\n",
        "                completed_task = sorted_tasks[task_index]\n",
        "                # Remove the task from the original 'tasks' list\n",
        "                tasks.remove(completed_task)\n",
        "\n",
        "                with open(COMPLETED_TASKS_FILE, 'a') as f:\n",
        "                    f.write(f\"{completed_task['name']}\\n\")\n",
        "                print(f\"Task '{completed_task['name']}' marked as complete and saved to {COMPLETED_TASKS_FILE}.\")\n",
        "                break\n",
        "            else:\n",
        "                print(\"Invalid task number. Please try again.\")\n",
        "        except ValueError:\n",
        "            print(\"Invalid input. Please enter a number.\")\n",
        "\n",
        "def main():\n",
        "    while True:\n",
        "        print(\"\\nPersonal Task Manager\")\n",
        "        print(\"1. Add Task\")\n",
        "        print(\"2. View Tasks\")\n",
        "        print(\"3. Complete Task\")\n",
        "        print(\"4. Exit\")\n",
        "\n",
        "        choice = input(\"Enter your choice: \")\n",
        "\n",
        "        if choice == '1':\n",
        "            add_task()\n",
        "        elif choice == '2':\n",
        "            view_tasks()\n",
        "        elif choice == '3':\n",
        "            complete_task()\n",
        "        elif choice == '4':\n",
        "            print(\"Exiting Task Manager. Goodbye!\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Invalid choice. Please try again.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
