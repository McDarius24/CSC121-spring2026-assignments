        "# IMPORT STATEMENTS\n",
        "# (None)\n",
        "\n",
        "# FUNCTION DEFINITIONS\n",
        "# 1. Define verify_pin():\n",
        "def verify_pin():\n",
        "#    - Create a loop that asks for a PIN until it equals \"1234\"\n",
        "    while True:\n",
        "        pin = input(\"Enter your PIN: \")\n",
        "        if pin == \"1234\":\n",
        "            print(\"PIN accepted.\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Incorrect PIN. Try again.\")\n",
        "#    - Return True\n",
        "    return True\n",
        "# 2. Define withdraw(balance, amount):\n",
        "def withdraw(balance, amount):\n",
        "    if amount <= balance:\n",
        "        balance -= amount\n",
        "        print(f\"Withdrawal of ${amount} successful.\")\n",
        "        print(\"withdrawal successful\")\n",
        "        return balance\n",
        "    else:\n",
        "        print(\"Insufficient funds.\")\n",
        "        return balance # Return the original balance if funds are insufficient\n",
        "#    - Check if enough money exists\n",
        "#    - Return the new (or old) balance\n",
        "\n",
        "# PROGRAM LOGIC\n",
        "# 1. Set current_balance to 500\n",
        "current_balance = 500\n",
        "# 2. Call verify_pin()\n",
        "if verify_pin():\n",
        "# 3. Get withdrawal amount from user input\n",
        "    amount = float(input(\"Enter withdrawal amount: \"))\n",
        "# 4. Update current_balance by calling withdraw()\n",
        "    current_balance = withdraw(current_balance, amount)\n",
        "# 5. Print the final balance\n",
        "    print(f\"Final balance: ${current_balance}\")\n",
