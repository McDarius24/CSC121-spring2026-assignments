        "# NAME: gradebook.py\n",
        "\n",
        "# IMPORT STATEMENTS\n",
        "# FUNCTION DEFINITIONS\n",
        "# Define add_students to accept a dictionary as a parameter.\n",
        "def add_students(gradebook):\n",
        "  # Use a loop to allow the user to input a student's name and grade (0-100), but the loop will end if the user types done.\n",
        "  while True:\n",
        "    name = input(\"Enter student's name (or type 'done' to finish): \")\n",
        "    if name.lower() == 'done':\n",
        "      break\n",
        "    try:\n",
        "      grade = int(input(f\"Enter {name}'s grade (0-100): \"))\n",
        "      if 0 <= grade <= 100:\n",
        "        gradebook[name] = grade\n",
        "      else:\n",
        "        print(\"Invalid grade. Please enter a value between 0 and 100.\")\n",
        "    except ValueError:\n",
        "      print(\"Invalid input. Please enter a valid integer grade.\")\n",
        "  return gradebook\n",
        "\n",
        "# Student's name is the key and the grade is the value.\n",
        "# Define calculate_average as a fruitful function that accepts gradebook dictionary\n",
        "def calculate_average(gradebook):\n",
        "  if not gradebook:\n",
        "    return 0\n",
        "  total_grade = sum(gradebook.values())\n",
        "  average_grade = total_grade / len(gradebook)\n",
        "  return average_grade\n",
        "# the calculate_average function should calculate and return all the grades of the students in the dictionary\n",
        "# Using values() will get you all the values from a dictionary.\n",
        "\n",
        "# PROGRAM LOGIC\n",
        "# Initialize an empty dictionary called gradebook\n",
        "gradebook = {}\n",
        "# Call add_students to populate the dictionary\n",
        "add_students(gradebook)\n",
        "# Call calculate_average and display the resulting class average\n",
        "average_grade = calculate_average(gradebook)\n",
        "print(f\"Class average: {average_grade:.2f}\")\n",
        "# Print the final report showing the student's name and their grade\n",
        "print(\"\\nStudent Report:\")\n",
        "for name, grade in gradebook.items():\n",
        "  print(f\"Student: {name}, Grade: {grade}\")\n",
        "  print(\"------------------\")"
      ]
    }
